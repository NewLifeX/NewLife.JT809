<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyTitle>JT809企业监管平台</AssemblyTitle>
    <Description></Description>
    <VersionPrefix>1.0</VersionPrefix>
    <VersionSuffix>$([System.DateTime]::Now.ToString(`yyyy.MMdd`))</VersionSuffix>
    <Version>$(VersionPrefix).$(VersionSuffix)</Version>
    <FileVersion>$(Version)</FileVersion>
    <AssemblyVersion>$(VersionPrefix).*</AssemblyVersion>
    <Deterministic>false</Deterministic>
    <OutputPath>..\Bin\Client2</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!--<Nullable>enable</Nullable>-->
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\JT809Client\Controllers\InfoController.cs" Link="Controllers\InfoController.cs" />
    <Compile Include="..\JT809Client\Controllers\J9200Controller.cs" Link="Controllers\J9200Controller.cs" />
    <Compile Include="..\JT809Client\Controllers\J9300Controller.cs" Link="Controllers\J9300Controller.cs" />
    <Compile Include="..\JT809Client\Controllers\J9400Controller.cs" Link="Controllers\J9400Controller.cs" />
    <Compile Include="..\JT809Client\Controllers\J9500Controller.cs" Link="Controllers\J9500Controller.cs" />
    <Compile Include="..\JT809Client\Controllers\J9600Controller.cs" Link="Controllers\J9600Controller.cs" />
    <Compile Include="..\JT809Client\Controllers\NormalController.cs" Link="Controllers\NormalController.cs" />
    <Compile Include="..\JT809Client\SlaveServer.cs" Link="SlaveServer.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NewLife.JT809\NewLife.JT809.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Controllers\" />
  </ItemGroup>

</Project>
