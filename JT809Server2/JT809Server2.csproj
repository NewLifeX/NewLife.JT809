<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyTitle>JT809政府监管平台</AssemblyTitle>
    <Description></Description>
    <VersionPrefix>1.0</VersionPrefix>
    <VersionSuffix>$([System.DateTime]::Now.ToString(`yyyy.MMdd`))</VersionSuffix>
    <Version>$(VersionPrefix).$(VersionSuffix)</Version>
    <FileVersion>$(Version)</FileVersion>
    <AssemblyVersion>$(VersionPrefix).*</AssemblyVersion>
    <Deterministic>false</Deterministic>
    <OutputPath>..\Bin\Server2</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!--<Nullable>enable</Nullable>-->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="appsettings.json" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\JT809Client\ControlConfig.cs" Link="ControlConfig.cs" />
    <Compile Include="..\JT809Server\Controllers\InfoController.cs" Link="Controllers\InfoController.cs" />
    <Compile Include="..\JT809Server\Controllers\J1200Controller.cs" Link="Controllers\J1200Controller.cs" />
    <Compile Include="..\JT809Server\Controllers\J1300Controller.cs" Link="Controllers\J1300Controller.cs" />
    <Compile Include="..\JT809Server\Controllers\J1400Controller.cs" Link="Controllers\J1400Controller.cs" />
    <Compile Include="..\JT809Server\Controllers\J1500Controller.cs" Link="Controllers\J1500Controller.cs" />
    <Compile Include="..\JT809Server\Controllers\J1600Controller.cs" Link="Controllers\J1600Controller.cs" />
    <Compile Include="..\JT809Server\Controllers\NormalController.cs" Link="Controllers\NormalController.cs" />
    <Compile Include="..\JT809Server\JT809Setting.cs" Link="JT809Setting.cs" />
    <Compile Include="..\JT809Server\MasterServer.cs" Link="MasterServer.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NewLife.Stardust" Version="3.10.2026.1018-beta1738" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NewLife.JT809\NewLife.JT809.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Controllers\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="FrmQuery.cs">
      <SubType>Form</SubType>
    </Compile>
  </ItemGroup>

</Project>